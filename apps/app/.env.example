# apps/app/.env.example — copiare in .env e riempire.
# MAI committare .env con valori reali (vedi .gitignore).

# Sentry DSN (pubblico per natura). Lasciare vuoto in dev per disabilitare Sentry.
PUBLIC_SENTRY_DSN=

# Ambiente: dev | staging | prod
PUBLIC_ENV=dev

# Release id per source map tagging (iniettato in CI; opzionale in dev)
# PUBLIC_RELEASE=0.0.0-dev

# ---- Analytics anonima (S8-3, D-010: opt-in default OFF) ----
# Senza chiave, il modulo analytics è un no-op totale (posthog-js mai caricato).
# PostHog EU cloud: https://eu.i.posthog.com (default, sovrascrivibile).
PUBLIC_POSTHOG_KEY=
# PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---- Beta (S9-2): bottone feedback in-app ----
# PUBLIC_BETA=true                      # mostra il bottone feedback
# PUBLIC_FEEDBACK_ENDPOINT=https://…   # POST {text,sentAt}[]; senza: coda locale

# ---- RevenueCat (Step 8 fase 2 — riempire quando l'account esiste) ----
PUBLIC_REVENUECAT_API_KEY=

# ---- Supabase (Step 7 — RINVIATO a Fase 1b per D-009=A: lasciare vuoti) ----
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
