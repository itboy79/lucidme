{
  "name": "lucidme",
  "version": "0.0.0",
  "private": true,
  "description": "Lucid Me — coach scientifico per la pratica e il tracciamento dei sogni lucidi. Monorepo (wiki-os: ../wiki-os).",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0 <25",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --filter=!@lucidme/e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --parallel",
    "native:sync": "pnpm --filter @lucidme/app build && cap sync",
    "native:ios": "pnpm native:sync && cap open ios",
    "native:android": "pnpm native:sync && cap open android",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-svelte": "^2.46.0",
    "prettier": "^3.4.0",
    "prettier-plugin-svelte": "^3.3.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0"
  }
}
