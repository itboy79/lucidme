{
  "name": "@lucidme/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Schema SQLite, migrazioni, repository pattern. Local-first, append-only + soft delete.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf build dist .turbo"
  },
  "dependencies": {
    "@lucidme/core": "workspace:*",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.5",
    "better-sqlite3": "^12.11.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
