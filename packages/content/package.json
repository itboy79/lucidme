{
  "name": "@lucidme/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Contenuti del Sentiero (percorso 21 giorni): markdown + frontmatter → bundle JSON validato. Le fonti citate devono esistere in wiki-os/99-fonti.md.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf build dist .turbo src/bundle.json"
  },
  "dependencies": {
    "@lucidme/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
