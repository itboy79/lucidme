{
  "name": "@lucidme/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system: token, componenti Svelte, i18n. Dipende da @lucidme/core (per tipi emozione/lucidity).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "clean": "rm -rf build dist .turbo"
  },
  "dependencies": {
    "@lucidme/core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "vitest": "^2.1.5"
  }
}
